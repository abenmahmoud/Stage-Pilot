# Supabase - récupérer depuis https://supabase.com/dashboard/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://sfqhxiamhgsbbogluqtq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Base de données Postgres (Transaction pooler shared IPv4-compat)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Configuration applicative
NEXT_PUBLIC_APP_URL=https://gestion.lycee-blaise-cendrars-sevran.fr
NEXT_PUBLIC_APP_NAME=LyceeGest - Blaise Cendrars

# La double vérification des agents est obligatoire dans le code.
# L'enrôlement reste accessible sur /security. Aucune variable ne la désactive.

# Les périmètres viennent uniquement des adhésions actives en base.
# L'ancienne valeur metadata est refusée ; aucune migration ni compte créé ici.
SUPPORT_MEMBERSHIP_SOURCE=database
SUPPORT_INSTITUTION_SLUG=blaise-cendrars-sevran

# Dépôt Lycée (VPS depot.essuf.tech -> LyceeGest). Le VPS conserve le jeton
# en clair ; LyceeGest ne conserve que son SHA-256 hexadécimal.
LYCEEGEST_DEPOT_TOKEN_SHA256=
# UUID du compte technique autorisé à signer les imports dans les audits.
LYCEEGEST_DEPOT_ACTOR_ID=
# Clé RSA privée PKCS#8 encodée en base64, uniquement côté serveur LyceeGest.
LYCEEGEST_CODES_PRIVATE_KEY_PEM_BASE64=

# Rechiffrement au repos des codes après ouverture de l'enveloppe LGC1.
CODE_VAULT_ENCRYPTION_KEY_VERSION=v1
CODE_VAULT_ENCRYPTION_KEY_V1=

# Chiffrement séparé des valeurs d'attributs nominatifs.
PERSON_ATTRIBUTE_ENCRYPTION_KEY_VERSION=v1
PERSON_ATTRIBUTE_ENCRYPTION_KEY_V1=

# Activer uniquement après la migration 20260830090000, la recette ROLLBACK et
# les auditeurs Supabase réussis sur la preview.
SUPPORT_ASSISTANT_ROUTING_REVIEW_ENABLED=false

# Premier adaptateur d'action de l'agent. Laisser faux tant que la recette DB
# fictive n'a pas validé compétence publiée, idempotence et reçu confirmed_at.
SUPPORT_AGENT_CREATE_REQUEST_ACTION_ENABLED=false

# Identité sans mot de passe : garder fermé jusqu'à la migration, au worker
# privé, à la recette fictive et à la validation des emails. Les deux drapeaux
# sont nécessaires ; l'interface seule n'ouvre aucun accès.
IDENTITY_DEVICE_ACCESS_ENABLED=false
VITE_IDENTITY_DEVICE_ACCESS_ENABLED=false
# Générer des secrets aléatoires distincts d'au moins 32 octets côté serveur.
IDENTITY_DEVICE_OTP_SECRET=
IDENTITY_DIRECTORY_LOOKUP_KEY_VERSION=v1
IDENTITY_DIRECTORY_LOOKUP_PUBLIC_KEY_V1=
IDENTITY_DIRECTORY_LOOKUP_RECEIPT_SECRET=
# La clé privée de transport et IDENTITY_CONTACT_PEPPER restent uniquement sur
# le worker privé, jamais dans Vercel ni dans une variable VITE_*.

# Renvoi d'un lien de suivi : garder les deux valeurs fausses jusqu'a la recette
# fictive et a la contre-revue. L'interface seule n'active jamais l'envoi serveur.
# Necessite VITE_SUPPORT_API_ENABLED, la file support et son worker compatibles.
SUPPORT_ACCESS_RECOVERY_ENABLED=false
VITE_SUPPORT_ACCESS_RECOVERY_ENABLED=false

# Facultatif : laissez vide pour utiliser l'origine courante.
# Toute valeur renseignée doit être autorisée dans Supabase Auth > URL Configuration.
VITE_PASSWORD_RESET_REDIRECT_URL=

# Centre de communications : les quatre interrupteurs restent faux jusqu'au
# pilote fictif et à la validation des rôles. L'interface seule ne peut pas
# ouvrir l'API, publier ou envoyer.
VITE_COMMUNICATIONS_ENABLED=false
COMMUNICATIONS_ENABLED=false
COMMUNICATION_PUBLICATION_ENABLED=false
COMMUNICATION_SEND_ENABLED=false

# Atelier « Hebdo vers À la une ». Laisser fermé dans la navigation jusqu'à
# la recette avec des documents fictifs ; l'API exige toujours un éditeur du site.
VITE_WEEKLY_BRIEF_UI_ENABLED=false

# Correction déterministe des brouillons WordPress repris. Laisser les deux
# valeurs à false tant que la migration locale et la recette preview ne sont
# pas explicitement autorisées et validées.
VITE_LEGACY_EDITORIAL_CORRECTIONS_ENABLED=false
LEGACY_EDITORIAL_CORRECTIONS_ENABLED=false

# Coffre de codes — révélation d'un code déchiffré à son bénéficiaire.
# Garder fermé (toute valeur autre que "true" ferme) tant que les trois
# parcours (ENT inactif, cantine, Koxo) et la recette adverse avec marqueur
# traqué n'ont pas tourné (LOT 3 et LOT 4,
# docs/operations/PLAN_LECTURE_COFFRE_2026-09-06.md). Le déchiffrement n'a
# lieu que dans la même transaction qu'une remise déjà accordée ; ce drapeau
# ne fait que fermer la sortie de la valeur vers la réponse HTTP.
CODE_VAULT_REVEAL_ENABLED=false

# Resend (emails) - optionnel pour les notifications
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=lyceegest@lycee-blaise-cendrars-sevran.fr

# --- Budget de l'agent IA -----------------------------------------------
# Le garde-fou est desactive par defaut. Tant que OPENAI_BUDGET_GUARD_ENABLED
# n'est pas exactement "true", aucun plafond ne s'applique. Une configuration
# incomplete ou mal ecrite fait echouer FERME : l'appel au modele est refuse,
# jamais autorise par defaut (prouve par npm run test:agent-ai-budget).
#
# Montants en euros canoniques, point decimal, six decimales au maximum.
# Valeurs recommandees pour le pilote de rentree, a poser AVANT de crediter
# l'API. Decision d'Adel du 5 septembre 2026 : 50 $ credites pour demarrer,
# puis ajustement sur la consommation reelle apres deux semaines.
OPENAI_BUDGET_GUARD_ENABLED=false

# Plafond global de la journee, toutes routes IA confondues. Atteint, l'agent
# rend sa reponse sans IA au lieu de contacter le fournisseur.
OPENAI_DAILY_BUDGET_EUR=1

# Reserve maximale d'UN appel, par operation. C'est ce qui empeche un seul
# appel anormal de consommer la journee entiere. Doit rester inferieure au
# plafond du jour, sinon la configuration est refusee.
OPENAI_SUPPORT_MAX_CALL_EUR=0.02
OPENAI_CONTENT_MAX_CALL_EUR=0.05
OPENAI_COMMUNICATION_MAX_CALL_EUR=0.05

# Modele utilise par l'assistant. Sa sortie est plafonnee a 450 tokens dans le
# code : c'est ce plafond, plus que le choix du modele, qui tient le budget.
OPENAI_SUPPORT_MODEL=gpt-5.6-luna
