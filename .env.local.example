# Supabase - récupérer depuis https://supabase.com/dashboard/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://sfqhxiamhgsbbogluqtq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Base de données Postgres (Transaction pooler shared IPv4-compat)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Configuration applicative
NEXT_PUBLIC_APP_URL=https://gestion.lycee-blaise-cendrars-sevran.fr
NEXT_PUBLIC_APP_NAME=LyceeGest - Blaise Cendrars

# La double vérification des agents est obligatoire dans le code.
# L'enrôlement reste accessible sur /security. Aucune variable ne la désactive.

# Les périmètres viennent uniquement des adhésions actives en base.
# L'ancienne valeur metadata est refusée ; aucune migration ni compte créé ici.
SUPPORT_MEMBERSHIP_SOURCE=database
SUPPORT_INSTITUTION_SLUG=blaise-cendrars-sevran

# Activer uniquement après la migration 20260830090000, la recette ROLLBACK et
# les auditeurs Supabase réussis sur la preview.
SUPPORT_ASSISTANT_ROUTING_REVIEW_ENABLED=false

# Premier adaptateur d'action de l'agent. Laisser faux tant que la recette DB
# fictive n'a pas validé compétence publiée, idempotence et reçu confirmed_at.
SUPPORT_AGENT_CREATE_REQUEST_ACTION_ENABLED=false

# Renvoi d'un lien de suivi : garder les deux valeurs fausses jusqu'a la recette
# fictive et a la contre-revue. L'interface seule n'active jamais l'envoi serveur.
# Necessite VITE_SUPPORT_API_ENABLED, la file support et son worker compatibles.
SUPPORT_ACCESS_RECOVERY_ENABLED=false
VITE_SUPPORT_ACCESS_RECOVERY_ENABLED=false

# Facultatif : laissez vide pour utiliser l'origine courante.
# Toute valeur renseignée doit être autorisée dans Supabase Auth > URL Configuration.
VITE_PASSWORD_RESET_REDIRECT_URL=

# Centre de communications : les quatre interrupteurs restent faux jusqu'au
# pilote fictif et à la validation des rôles. L'interface seule ne peut pas
# ouvrir l'API, publier ou envoyer.
VITE_COMMUNICATIONS_ENABLED=false
COMMUNICATIONS_ENABLED=false
COMMUNICATION_PUBLICATION_ENABLED=false
COMMUNICATION_SEND_ENABLED=false

# Correction déterministe des brouillons WordPress repris. Laisser les deux
# valeurs à false tant que la migration locale et la recette preview ne sont
# pas explicitement autorisées et validées.
VITE_LEGACY_EDITORIAL_CORRECTIONS_ENABLED=false
LEGACY_EDITORIAL_CORRECTIONS_ENABLED=false

# Resend (emails) - optionnel pour les notifications
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=lyceegest@lycee-blaise-cendrars-sevran.fr
