{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/import/*.ts": {
      "maxDuration": 300
    },
    "api/content/admin/legacy-import.ts": {
      "maxDuration": 300
    },
    "api/support/assistant.ts": {
      "maxDuration": 30
    },
    "api/cron/support-worker.ts": {
      "maxDuration": 60
    },
    "api/cron/knowledge-expiry.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/knowledge-expiry",
      "schedule": "15 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob: https://*.supabase.co; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/1159-2", "destination": "/site/1159-2", "permanent": true },
    { "source": "/bac-general", "destination": "/site/bac-general", "permanent": true },
    { "source": "/bac-professionnel", "destination": "/site/bac-professionnel", "permanent": true },
    { "source": "/bac-technologique", "destination": "/site/bac-technologique", "permanent": true },
    { "source": "/bal-de-fin-dannee", "destination": "/site/bal-de-fin-dannee", "permanent": true },
    { "source": "/cap-etl", "destination": "/site/cap-etl", "permanent": true },
    { "source": "/cdi", "destination": "/site/cdi", "permanent": true },
    { "source": "/contact", "destination": "/site/contact", "permanent": true },
    { "source": "/exposition-loeuvre-dart-du-mois", "destination": "/site/exposition-loeuvre-dart-du-mois", "permanent": true },
    { "source": "/formations", "destination": "/site/formations", "permanent": true },
    { "source": "/hlp", "destination": "/site/hlp", "permanent": true },
    { "source": "/https-docs-google-com-forms-d-e-1faipqlsety2swpyoogjbjt-qj2tz9z6fnhwk5if_valme6sup9ukayw-viewform", "destination": "/site/https-docs-google-com-forms-d-e-1faipqlsety2swpyoogjbjt-qj2tz9z6fnhwk5if-valme6sup9ukayw-viewform", "permanent": true },
    { "source": "/llce", "destination": "/site/llce", "permanent": true },
    { "source": "/localisation", "destination": "/site/localisation", "permanent": true },
    { "source": "/london-trip-review", "destination": "/site/london-trip-review", "permanent": true },
    { "source": "/maths", "destination": "/site/maths", "permanent": true },
    { "source": "/nouveau-site-lycee", "destination": "/site/nouveau-site-lycee", "permanent": true },
    { "source": "/nsi", "destination": "/site/nsi", "permanent": true },
    { "source": "/planning-de-rentree-2024", "destination": "/site/planning-de-rentree-2024", "permanent": true },
    { "source": "/presentation-lycee", "destination": "/site/presentation-lycee", "permanent": true },
    { "source": "/presentations-clubs", "destination": "/site/presentations-clubs", "permanent": true },
    { "source": "/se-connecter", "destination": "/site/se-connecter", "permanent": true },
    { "source": "/specialites", "destination": "/site/specialites", "permanent": true },
    { "source": "/tournoi-de-football", "destination": "/site/tournoi-de-football", "permanent": true },
    { "source": "/un-atelier-pour-etre-plus-a-laise-a-loral", "destination": "/site/un-atelier-pour-etre-plus-a-laise-a-loral", "permanent": true },
    { "source": "/unss", "destination": "/site/unss", "permanent": true },
    { "source": "/vie-du-lycee", "destination": "/site/vie-du-lycee", "permanent": true },
    { "source": "/category/:path*", "destination": "/?view=news", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
